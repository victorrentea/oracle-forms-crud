      <Trigger Name="POST-QUERY" TriggerText="begin&#10;  select name into :orders.customer_name from customers where id = :orders.customer_id;&#10;exception&#10;  when no_data_found then null;&#10;end;"/>
    </Block>
    <Block Name="CONTROL" DatabaseBlock="false" RecordsDisplayCount="1">
      <Item Name="SHIP" ItemType="Push Button" Label="Ship" CanvasName="CANVAS1" XPosition="10" YPosition="260" Width="100" Height="22" MouseNavigate="false" KeyboardNavigable="false"><Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="declare&#10;  v_id number := :orders.id;&#10;begin&#10;  if v_id is null then&#10;    message('Select a saved order first');&#10;    return;&#10;  end if;&#10;  orders_api.ship_order(v_id);&#10;  forms_ddl('COMMIT');&#10;  go_block('ORDERS');&#10;  execute_query;&#10;  message('FRM-40400: Transaction complete: 1 records applied and saved.');&#10;exception&#10;  when others then&#10;    message(sqlerrm);&#10;    forms_ddl('ROLLBACK');&#10;end;"/></Item><Item Name="CANCEL_ORDER" ItemType="Push Button" Label="Cancel Order" CanvasName="CANVAS1" XPosition="120" YPosition="260" Width="100" Height="22" MouseNavigate="false" KeyboardNavigable="false"><Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="declare&#10;  v_id number := :orders.id;&#10;begin&#10;  if v_id is null then&#10;    message('Select a saved order first');&#10;    return;&#10;  end if;&#10;  orders_api.cancel_order(v_id);&#10;  forms_ddl('COMMIT');&#10;  go_block('ORDERS');&#10;  execute_query;&#10;  message('FRM-40400: Transaction complete: 1 records applied and saved.');&#10;exception&#10;  when others then&#10;    message(sqlerrm);&#10;    forms_ddl('ROLLBACK');&#10;end;"/></Item>
