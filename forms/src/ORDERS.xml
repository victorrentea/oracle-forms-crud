      <Trigger Name="ON-INSERT" TriggerText="begin&#10;  orders_api.create_order(:orders.customer_id, :orders.product, :orders.quantity, :orders.unit_price, :orders.id);&#10;exception&#10;  when others then&#10;    message(sqlerrm);&#10;    raise form_trigger_failure;&#10;end;"/>
